# Copy to .env in the project root. Keys never enter the renderer.
APP_MODE=local
DATABASE_URL=

# Providers. Leave both unset to auto-detect: Local Whisper and Ollama are
# chosen when they are installed and ready, otherwise clearly labelled mocks.
# TRANSCRIPTION_PROVIDER=whisper   # whisper | deepgram | mock
# AI_PROVIDER=ollama               # ollama | openai | anthropic | mock

# Local Whisper (whisper.cpp). Models default to ~/.recallflow/models.
WHISPER_MODEL=base
# WHISPER_MODEL_PATH=/path/to/ggml-base.en.bin
# WHISPER_MODEL_DIR=/path/to/models
# WHISPER_SERVER_PATH=/opt/homebrew/bin/whisper-server

# Ollama (local LLM). No API key; the host should stay on this device.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# OLLAMA_NUM_CTX=32768   # maximum context; more fits longer meetings, uses more RAM

# Cloud providers
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
